<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PictureSharp.Formats.Heif</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>PictureSharp.Heif</PackageId>
    <Description>HEIC/HEIF format plugin for PictureSharp, written entirely in C#. No native dependencies.</Description>
    <PackageTags>picturesharp;image;heic;heif;hevc;codec;decoder;encoder;iphone</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/art-ix/PictureSharp.Heif</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.6.4: raw depth and disparity samples (HeifDocument.LoadDepth, HeifDepthImage) at the coded bit depth with grids and transforms, and Live Photo pairing (LivePhotoPair) of a HEIC/JPEG photo and a MOV by ContentIdentifier, with the still image time. Image decoding unchanged. Requires PictureSharp 0.7.6. Notes: https://github.com/art-ix/PictureSharp.Heif/blob/v0.6.4/docs/releases/release-0.6.4.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency: the public API of the PictureSharp package, never a project reference to its sources. -->
    <PackageReference Include="PictureSharp" Version="$(PictureSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
