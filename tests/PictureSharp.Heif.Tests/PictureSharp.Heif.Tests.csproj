<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- TUnit0046 asks for Func<T> data sources for reference-type arguments; the tests never mutate their inputs. -->
    <NoWarn>$(NoWarn);CA1707;TUnit0046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.72.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../assets/PublicApi.approved.txt" Link="PublicApi.approved.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/p3_v4_para0.icc" Link="p3_v4_para0.icc" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/corpus/**" Link="corpus/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../assets/hevc/**" Link="hevc/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The HEVC layer is self-contained; compiling its sources into the tests checks YCbCr output bit for bit without
         InternalsVisibleTo on the plugin. -->
    <Compile Include="../../src/PictureSharp.Heif/Hevc/**/*.cs" Link="Hevc/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="TUnit.Assertions.Enums" />
    <ProjectReference Include="..\..\src\PictureSharp.Heif\PictureSharp.Heif.csproj" />
  </ItemGroup>

</Project>
